#! /usr/bin/env bash
tests_dir()
{
    dirname "$(readlink -f "${BASH_SOURCE}")"
}

lib_dir()
{
    echo "$(tests_dir)/lib"
}

. "$(lib_dir)"/functions

_start_ms=$(date +%s%3N)

if [ -z "$1" ]; then
    for testfile in "$(tests_dir)"/*-test; do
        CURRENT_TEST_FILE="$(basename "${testfile}")"
        . "${testfile}"
        echo -e "\n----------\n"
    done
else
    if [ -e "$1" ]; then
        CURRENT_TEST_FILE="$(basename "$1")"
        . "$1"
        echo -e "\n----------\n"
    else
        echo "File not found: $1"
        exit 1
    fi
fi

_end_ms=$(date +%s%3N)
_duration_ms=$(( _end_ms - _start_ms ))

PASSED="$((TESTS - ERRORS - SKIPPED))"
echo -e "${PASSED} passed / ${SKIPPED} skipped / ${ERRORS} failed — ${TESTS} tests in ${_duration_ms}ms"

[ "${ERRORS}" -eq 0 ]

if [ "${ERRORS}" -gt 0 ]; then
    echo -e "\nFailed tests:"
    declare -A _by_file=()
    for _entry in "${FAILED_TESTS[@]}"; do
        _file="${_entry%%|*}"
        _test="${_entry#*|}"
        _by_file["${_file}"]+="${_test}"$'\n'
    done
    for _file in $(printf '%s\n' "${!_by_file[@]}" | sort); do
        echo -e "\n  \e[1m${_file}\e[0m:"
        while IFS= read -r _test; do
            [ -n "${_test}" ] && echo -e "    \e[31m\u2718\e[0m ${_test}"
        done < <(echo "${_by_file[${_file}]}" | sort)
    done
fi
